# Copy to backend/.env to override defaults (all variables use the QOLDAU_ prefix)
QOLDAU_DATABASE_URL=sqlite:///./qoldau.db
QOLDAU_SECRET_KEY=change-me-in-production-please-32-bytes-min
QOLDAU_SMTP_HOST=
QOLDAU_SMTP_PORT=587
QOLDAU_SMTP_USER=
QOLDAU_SMTP_PASSWORD=

# Sprint 4
QOLDAU_EXPORT_DIR=./exports                    # private report files (stand-in for S3)
QOLDAU_EXPORT_LINK_HOURS=24                    # signed download links
QOLDAU_EMBEDDING_PROVIDER=local                # local | sentence-transformers
QOLDAU_EMBEDDING_MODEL=intfloat/multilingual-e5-small
QOLDAU_RETRAIN_MIN_FEEDBACK=200                # new agent corrections needed before retraining
QOLDAU_RETRAIN_WEEKLY=true                     # Monday 02:00 UTC scheduled retrain
QOLDAU_MODEL_SYNC_SECONDS=30                   # workers pick up activations / rollbacks within this window
QOLDAU_SMART_REPLY_LLM_ENABLED=false           # optional LLM rewriter for smart replies
QOLDAU_SMART_REPLY_LLM_PROVIDER=
