# Copy to a private file outside Git and fill with unique values.
QOLDAU_DOMAIN=qoldau.example.org
QOLDAU_DB_PASSWORD=replace-with-a-unique-database-password
QOLDAU_DATABASE_URL=postgresql+psycopg://qoldau:replace-with-a-unique-database-password@db:5432/qoldau
QOLDAU_SECRET_KEY=replace-with-at-least-32-random-characters

# Fill these after approval from the pilot owner and mail administrator.
QOLDAU_PILOT_SUPPORT_EMAIL=
QOLDAU_PILOT_DIRECTORY_PUBLISHED=false
QOLDAU_PILOT_DATA_CONTACT=
QOLDAU_PILOT_PRIVACY_URL=
QOLDAU_SMTP_HOST=
QOLDAU_SMTP_PORT=587
QOLDAU_SMTP_SECURITY=starttls
QOLDAU_SMTP_USER=
QOLDAU_SMTP_PASSWORD=
QOLDAU_SMTP_FROM=

# Keep uploads disabled until a private, maintained scanner is available.
QOLDAU_ATTACHMENT_MODE=disabled
QOLDAU_CLAMAV_HOST=
QOLDAU_CLAMAV_PORT=3310
